# Copy this file to ".env" and fill in your own values. Never share the real .env or commit it.

# ---- Required ----
DATABASE_URL="postgresql://postgres:YOUR_POSTGRES_PASSWORD@localhost:5432/szabu?schema=public"
# Long random text that signs login tokens (at least 32 characters). Create one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="CHANGE_ME_to_a_long_random_value"
PORT=5000

# ---- Real verification emails (optional) ----
# Without these lines codes are printed in the server window and shown in the admin dev inbox.
# For Gmail use an App Password (Google Account > Security > 2-Step Verification > App passwords).
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT=587
# SMTP_USER="your-address@gmail.com"
# SMTP_PASS="your-16-letter-app-password"
# SMTP_FROM="your-address@gmail.com"

# ---- Phone notifications (Web Push) ----
# Create a pair with:  npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY="..."
# VAPID_PRIVATE_KEY="..."
# VAPID_SUBJECT="mailto:admin@szabist.edu.pk"

# ---- Deployment (production) ----
# NODE_ENV=production
# Websites allowed to call the API, comma separated. In development localhost and local-network addresses
# are allowed automatically.
# CLIENT_ORIGIN="https://szabu.vercel.app"
# Set to 1 when the server runs behind a proxy (Railway, etc.) so rate limits see the real visitor address.
# TRUST_PROXY=1
